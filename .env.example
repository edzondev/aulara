# Copy to .env and replace every placeholder with real values.
# Never commit .env files.

# PostgreSQL connection used by @aulara/db (Neon or any PostgreSQL).
DATABASE_URL=postgresql://user:password@host.db.provider.com/neondb?sslmode=require

# Better Auth secret. Must be at least 32 characters in production.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Internal URL where platform serves the Better Auth API.
# Local `pnpm dev` pins platform to :3000 and admin to :3001 so this stays valid.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of exact origins Better Auth should trust.
# No wildcards are allowed.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional cookie domain for cross-subdomain sessions.
# Leave empty for same-origin local development.
BETTER_AUTH_COOKIE_DOMAIN=

# Public URL exposed to browser clients (admin, platform).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional: enables the PostgreSQL integrity test suite.
TEST_DATABASE_URL=
