{
	"name": "app-aulara",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"check-types": "turbo run check-types",
		"auth:generate": "pnpm --filter=@aulara/auth auth:generate",
		"auth:create-admin": "pnpm --filter=@aulara/auth auth:create-admin",
		"db:check": "pnpm --filter=@aulara/db db:check",
		"db:generate": "pnpm --filter=@aulara/db db:generate",
		"db:migrate": "pnpm --filter=@aulara/db db:migrate",
		"db:studio": "pnpm --filter=@aulara/db db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"turbo": "^2.10.12",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	}
}
