{
	"name": "@aulara/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"exports": {
		"./client": "./src/client.ts",
		"./schema": "./src/schema/index.ts",
		"./queries/members": "./src/queries/members.ts",
		"./queries/schools": "./src/queries/schools.ts",
		"./queries/invitations": "./src/queries/invitations.ts",
		"./queries/billing-contracts": "./src/queries/billing-contracts.ts",
		"./queries/tuition-rates": "./src/queries/tuition-rates.ts",
		"./queries/charge-balances": "./src/queries/charge-balances.ts",
		"./queries/waitlist-leads": "./src/queries/waitlist-leads.ts"
	},
	"scripts": {
		"lint": "biome check --write",
		"format": "biome format --write",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"db:check": "drizzle-kit check --config=drizzle.config.ts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=drizzle.config.ts"
	},
	"dependencies": {
		"@aulara/env": "workspace:*",
		"@neondatabase/serverless": "1.0.2",
		"drizzle-orm": "0.45.2"
	},
	"devDependencies": {
		"@aulara/ts-config": "workspace:*",
		"@biomejs/biome": "2.5.10",
		"@types/node": "26.3.0",
		"drizzle-kit": "0.31.10",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@11.24.0"
}
